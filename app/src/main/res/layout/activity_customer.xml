<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/customerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/washapp_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="4dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/washapp_on_primary"
            android:textAppearance="@style/TextAppearance.WashApp.Title" />

        <ImageButton
            android:id="@+id/logoutButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logout"
            android:padding="12dp"
            android:src="@drawable/ic_logout" />

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/customerNavHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/customerTopBar"
        app:layout_constraintBottom_toTopOf="@id/customerBottomNav"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_customer" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/customerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/washapp_surface"
        app:elevation="8dp"
        app:itemTextAppearanceActive="@style/TextAppearance.WashApp.NavLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.WashApp.NavLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_customer" />

</androidx.constraintlayout.widget.ConstraintLayout>
