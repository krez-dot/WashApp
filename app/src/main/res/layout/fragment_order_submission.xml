<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_submit_order"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/loadSizeInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_load_size"
        android:inputType="numberDecimal"
        android:layout_marginTop="16dp" />

    <CheckBox
        android:id="@+id/coloredCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_colored"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/submitOrderButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_submit_order"
        android:layout_marginTop="16dp" />

</LinearLayout>
