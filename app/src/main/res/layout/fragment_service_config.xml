<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_service_non_colored"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/nonColoredPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_price_per_kg"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/nonColoredWashInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_wash_minutes_per_kg"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/nonColoredDryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_dry_minutes_per_kg"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/saveNonColoredButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_service_colored"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/coloredPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_price_per_kg"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/coloredWashInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_wash_minutes_per_kg"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/coloredDryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_dry_minutes_per_kg"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/saveColoredButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
