<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/queuePositionBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_queue_badge"
            android:gravity="center"
            android:textColor="@color/washapp_on_primary"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            tools:text="2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/queueOrderSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.WashApp.Title"
                tools:text="Order a1b2c3" />

            <TextView
                android:id="@+id/queueOrderDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.WashApp.Body"
                tools:text="Non-Colored · 2.4 kg" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/moveUpButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_move_up"
            android:padding="10dp"
            android:src="@drawable/ic_move_up"
            app:tint="@color/washapp_primary" />

        <ImageButton
            android:id="@+id/moveDownButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_move_down"
            android:padding="10dp"
            android:src="@drawable/ic_move_down"
            app:tint="@color/washapp_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
