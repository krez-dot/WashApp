<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WashApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/washapp_primary</item>
        <item name="colorPrimaryDark">@color/washapp_primary_dark</item>
        <item name="colorAccent">@color/washapp_accent</item>
        <item name="colorOnPrimary">@color/washapp_on_primary</item>
        <item name="colorSurface">@color/washapp_surface</item>
        <item name="colorOnSurface">@color/washapp_on_surface</item>
        <item name="colorError">@color/washapp_error</item>
        <item name="android:windowBackground">@color/washapp_background</item>
        <item name="materialButtonStyle">@style/Widget.WashApp.Button</item>
        <item name="textInputStyle">@style/Widget.WashApp.TextInputLayout</item>
    </style>

    <style name="Widget.WashApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.WashApp.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="Widget.WashApp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/washapp_primary</item>
        <item name="hintTextColor">@color/washapp_primary</item>
    </style>

    <style name="TextAppearance.WashApp.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/washapp_on_surface</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <style name="TextAppearance.WashApp.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/washapp_on_surface</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.WashApp.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/washapp_on_surface_variant</item>
    </style>

    <style name="TextAppearance.WashApp.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
</resources>
